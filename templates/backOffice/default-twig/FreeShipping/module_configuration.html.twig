{% set domain = 'freeshipping' %}

<div class="row g-4" data-testid="free-shipping-configuration">
    <div class="col-12 col-xl-5">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">{{ 'How the threshold is compared'|trans({}, domain) }}</h2>
            </div>
            <div class="card-body">
                {% form_theme settings_form with bo_form_themes only %}
                {{ form_start(settings_form, { action: '/admin/module/FreeShipping/settings', method: 'POST', attr: { 'data-testid': 'free-shipping-settings-form' } }) }}
                    {{ form_errors(settings_form) }}
                    {{ form_row(settings_form.threshold_includes_taxes) }}
                    <p class="form-text mb-4">{{ 'Turn it off to compare the total before taxes, as a business to business shop expects.'|trans({}, domain) }}</p>
                    {{ form_row(settings_form.deduct_discounts) }}
                    <p class="form-text mb-0">{{ 'Turn it off to compare the total before any promotion code or discount.'|trans({}, domain) }}</p>
                    <button type="submit" class="btn btn-primary mt-3">{{ 'Save'|trans({}, domain) }}</button>
                {{ form_end(settings_form) }}
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-7">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="h5 mb-0">
                    {% if edited_rule_id %}
                        {{ 'Edit a rule'|trans({}, domain) }}
                    {% else %}
                        {{ 'Add a rule'|trans({}, domain) }}
                    {% endif %}
                </h2>
            </div>
            <div class="card-body">
                {% form_theme rule_form with bo_form_themes only %}
                {{ form_start(rule_form, { action: '/admin/module/FreeShipping/rule/save', method: 'POST', attr: { 'data-testid': 'free-shipping-rule-form' } }) }}
                    {{ form_errors(rule_form) }}
                    {{ form_row(rule_form.area_id) }}
                    <p class="form-text mb-4">{{ 'Applies to orders delivered to a country of this area. Set the countries in Configuration, Delivery zones.'|trans({}, domain) }}</p>

                    {{ form_row(rule_form.delivery_module_id) }}
                    <p class="form-text mb-4">{{ 'Every carrier offers it. Pick one and the others keep their price.'|trans({}, domain) }}</p>

                    {{ form_row(rule_form.threshold) }}
                    <p class="form-text mb-4">{{ 'Offered from this amount, threshold included. Compares the cart products, shipping excluded, %taxes%, %discounts%.'|trans({
                        '%taxes%': (threshold_includes_taxes ? 'tax included' : 'before taxes')|trans({}, domain),
                        '%discounts%': (deduct_discounts ? 'discounts subtracted' : 'discounts not subtracted')|trans({}, domain),
                    }, domain) }}</p>

                    {{ form_row(rule_form.start_date) }}
                    <p class="form-text mb-4">{{ 'Optional. Starts at 00:00 that day, server time. Empty for no start date.'|trans({}, domain) }}</p>

                    {{ form_row(rule_form.end_date) }}
                    <p class="form-text mb-4">{{ 'Optional. Runs to the end of that day, server time. Empty for no end date.'|trans({}, domain) }}</p>

                    {{ form_row(rule_form.active) }}
                    <p class="form-text mb-0">{{ 'An inactive rule is kept but ignored, at the checkout and in the cart message.'|trans({}, domain) }}</p>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, domain) }}</button>
                        {% if edited_rule_id %}
                            <a class="btn btn-outline-secondary" href="/admin/module/FreeShipping">{{ 'Cancel'|trans({}, domain) }}</a>
                        {% endif %}
                    </div>
                {{ form_end(rule_form) }}
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">{{ 'Free shipping rules'|trans({}, domain) }}</h2>
            </div>
            <div class="card-body">
                {% if rules is empty %}
                    <p class="text-muted mb-0">{{ 'No rule yet. Shipping is charged as usual.'|trans({}, domain) }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">{{ 'Delivery area'|trans({}, domain) }}</th>
                                    <th scope="col">{{ 'Carrier'|trans({}, domain) }}</th>
                                    <th scope="col">{{ 'Threshold'|trans({}, domain) }}</th>
                                    <th scope="col">{{ 'Period'|trans({}, domain) }}</th>
                                    <th scope="col">{{ 'Active'|trans({}, domain) }}</th>
                                    <th scope="col" class="text-end">{{ 'Actions'|trans({}, domain) }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rule in rules %}
                                    <tr data-testid="free-shipping-rule-row">
                                        <td>{{ rule.area }}</td>
                                        <td>{{ rule.carrier }}</td>
                                        <td>{{ rule.threshold|number_format(2, '.', ' ') }}</td>
                                        <td>
                                            {% if rule.start_date or rule.end_date %}
                                                {{ rule.start_date|default('...') }} &rsaquo; {{ rule.end_date|default('...') }}
                                            {% else %}
                                                {{ 'Always'|trans({}, domain) }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if rule.active %}
                                                <span class="badge text-bg-success">{{ 'Yes'|trans({}, domain) }}</span>
                                            {% else %}
                                                <span class="badge text-bg-secondary">{{ 'No'|trans({}, domain) }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-secondary" href="/admin/module/FreeShipping?rule={{ rule.id }}">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                                {{ 'Edit'|trans({}, domain) }}
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#free-shipping-rule-delete-modal"
                                                    data-rule-id="{{ rule.id }}"
                                                    data-testid="free-shipping-rule-delete-button">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                                {{ 'Delete'|trans({}, domain) }}
                                            </button>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{{ component('BoConfirmDialog', {
    id: 'free-shipping-rule-delete-modal',
    title: 'Delete this free shipping rule'|trans({}, domain),
    formAction: '/admin/module/FreeShipping/rule/delete',
    message: 'Do you really want to delete this free shipping rule ?'|trans({}, domain),
    confirmLabel: 'Delete'|trans({}, domain),
    cancelLabel: 'Cancel'|trans({}, domain),
    testid: 'free-shipping-rule-delete',
    prefillTrigger: 'data-rule-id',
    prefillInput: 'rule_id',
}) }}
